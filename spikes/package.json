{
  "name": "musicsync-spikes",
  "private": true,
  "description": "Phase 0 throwaway spikes: Hue Entertainment streaming, Spotify playback clock, PC loopback audio.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "hue:pair": "node hue/pair.ts",
    "hue:area": "node hue/area.ts",
    "hue:stream": "node hue/stream.ts",
    "spotify:login": "node spotify/login.ts",
    "spotify:clock": "node spotify/clock.ts",
    "spotify:analyze": "node spotify/analyze.ts",
    "audio:build": "cargo build --release --manifest-path audio/loopback/Cargo.toml",
    "audio:dsp": "node audio/dsp.ts",
    "audio:selftest": "node audio/selftest.ts",
    "demo:flash": "node demo/flash.ts"
  },
  "dependencies": {
    "node-dtls-client": "2.0.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
